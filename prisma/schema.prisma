generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Camera {
  id                     Int         @id @default(autoincrement())
  name                   String
  source                 String
  camera_type            String      @default("USB")
  zone                   String?
  is_active              Boolean     @default(true)
  created_at             DateTime    @default(now())
  status                 String      @default("offline")
  roi_zones              String?
  exclusion_zones        String?
  detection_threshold    Float?
  min_face_size          Int?
  max_face_size          Int?
  fps                    Int         @default(25)
  ping_ms                Int         @default(0)
  is_smart_recording     Boolean     @default(false)
  is_chronicle           Boolean     @default(true)
  driver_type            String?
  ip_address             String?
  ip_port                Int?
  username               String?
  password               String?
  use_camera_analytics   Boolean     @default(false)
  faiss_sync_status      String?     @default("SYNCED")
  faiss_dirty_at         DateTime?
  passage_roi_x_min      Float?      @default(0.3)
  passage_roi_x_max      Float?      @default(0.65)
  passage_roi_y_min      Float?      @default(0.1)
  passage_roi_y_max      Float?      @default(0.8)
  guard_ignore_x_max     Float?      @default(0.3)
  detected_width         Int?
  detected_height        Int?
  detected_fps           Float?
  detected_codec         String?
  detected_bitrate_kbps  Int?
  detected_gop           Int?
  detected_at            DateTime?
  profile_version        Int         @default(1)
  profile_needs_refresh  Boolean     @default(false)
  override_width         Int?
  override_height        Int?
  override_fps           Float?
  stream_main_url        String?
  stream_sub_url         String?
  use_substream_tracking Boolean     @default(true)
  force_decode_strategy  String?
  detection_max_width    Int         @default(960)
  roi_polygon            String?
  distance_calib_mode    String?
  person_calib_pts_px    String?
  person_calib_depth_m   String?
  floor_calib_pts_px     String?
  floor_calib_pts_m      String?
  floor_homography       String?
  stream_recommendation  String?
  ai_proxy_stats         String?
  feedback_counts        String?
  events                 Event[]
  recordings             Recording[]
}

model SystemConfig {
  id                     String   @id @default("default")
  server_decode_strategy String   @default("auto")
  server_has_gpu         Boolean  @default(false)
  server_hw_min_cameras  Int      @default(4)
  server_hw_min_pixels   Int      @default(8294400)
  health_rules_version   String   @default("v3")
  updated_at             DateTime @updatedAt
}

model Category {
  id             Int     @id @default(autoincrement())
  code           String  @unique
  label          String
  color          String
  bg_color       String
  is_alert       Boolean @default(false)
  alert_sound    String  @default("off")
  alert_volume   Float   @default(0.5)
  detect_enabled Boolean @default(true)
  sort_order     Int     @default(100)
  is_system      Boolean @default(false)
}

model Person {
  id              Int                @id @default(autoincrement())
  name            String
  category        String
  position        String?
  comment         String?
  phone           String?
  email           String?
  birth_date      String?
  address         String?
  organization    String?
  extra_info      String?
  photo_path      String?
  is_active       Boolean            @default(true)
  created_at      DateTime           @default(now())
  last_seen_at    DateTime?
  visit_count     Int                @default(0)
  embedding_count Int                @default(0)
  events          Event[]
  descriptors     FaceDescriptor[]
  incidents       Incident[]
  tags            Tag[]
  confirmations   FaceConfirmation[]
  photos          PersonPhoto[]
}

model FaceDescriptor {
  id         Int      @id @default(autoincrement())
  person_id  Int
  photo_path String
  descriptor String
  created_at DateTime @default(now())
  person     Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
}

model PersonPhoto {
  id            Int      @id @default(autoincrement())
  person_id     Int
  photo_path    String
  is_primary    Boolean  @default(false)
  has_embedding Boolean  @default(false)
  source        String   @default("manual")
  confidence    Float?
  created_at    DateTime @default(now())
  person        Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@map("person_photos")
}

model FaceConfirmation {
  id                  Int       @id @default(autoincrement())
  person_id           Int
  confidence          Float
  temp_photo_path     String
  existing_photo_path String?
  person_name         String?
  category            String?
  status              String    @default("PENDING")
  created_at          DateTime  @default(now())
  confirmed_at        DateTime?
  confirmed_by        String?
  rejected_reason     String?
  person              Person    @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([person_id])
  @@map("face_confirmations")
}

model Event {
  id                          Int      @id @default(autoincrement())
  camera_id                   Int
  camera_name                 String
  person_id                   Int?
  event_type                  String
  confidence                  Float
  snapshot_path               String?
  person_name                 String?
  person_category             String?
  person_photo_path           String?
  created_at                  DateTime @default(now())
  needs_operator_confirmation Boolean  @default(false)
  confirmation_status         String?
  confirmation_id             Int?
  person                      Person?  @relation(fields: [person_id], references: [id])
  camera                      Camera   @relation(fields: [camera_id], references: [id], onDelete: Cascade)

  @@index([camera_id])
  @@index([person_id])
  @@index([created_at])
  @@index([confirmation_id])
}

model Recording {
  id          Int      @id @default(autoincrement())
  camera_id   Int
  camera_name String
  start_time  DateTime
  end_time    DateTime
  duration    Int
  size_mb     Float
  video_path  String
  is_favorite Boolean  @default(false)
  camera      Camera   @relation(fields: [camera_id], references: [id], onDelete: Cascade)
}

model Incident {
  id            Int      @id @default(autoincrement())
  person_id     Int
  incident_type String
  severity      String
  comment       String?
  status        String   @default("open")
  created_at    DateTime @default(now())
  person        Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

model Tag {
  id        Int    @id @default(autoincrement())
  person_id Int
  tag       String
  person    Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

model Settings {
  key   String @id
  value String
}

model FaissUpdateLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  action    String
  details   String?
  status    String
}

model Operator {
  id           Int               @id @default(autoincrement())
  login        String            @unique
  display_name String
  role         String            @default("reviewer")
  active       Boolean           @default(true)
  created_at   DateTime          @default(now())
  decisions    OperatorVerdict[]
}

model RecognitionIncident {
  id                     Int               @id @default(autoincrement())
  original_photo_path    String
  ai_candidate_person_id Int?
  ai_confidence          Float
  status                 String            @default("OPEN")
  created_at             DateTime          @default(now())
  resolved_at            DateTime?
  source_event_id        Int?              @unique
  decisions              OperatorVerdict[]
}

model OperatorVerdict {
  id          Int                 @id @default(autoincrement())
  incident_id Int
  operator_id Int
  decision    String
  screen_path String?
  comment     String?
  timestamp   DateTime            @default(now())
  operator    Operator            @relation(fields: [operator_id], references: [id])
  incident    RecognitionIncident @relation(fields: [incident_id], references: [id])

  @@index([incident_id])
  @@index([operator_id])
  @@index([decision])
}

model ImportSession {
  id                       Int           @id @default(autoincrement())
  start_time               DateTime      @default(now())
  operator_login           String?
  workspace                String
  machine_name             String?
  app_version              String?
  model_version            String?
  gpu                      String?
  cpu                      String?
  workspace_version        String?
  total_files              Int           @default(0)
  completed                Int           @default(0)
  rejected                 Int           @default(0)
  errors                   Int           @default(0)
  status                   String        @default("RUNNING")
  last_checkpoint_at       DateTime?
  last_checkpoint_progress Int           @default(0)
  ended_at                 DateTime?
  tasks                    ArchiveTask[]
}

model ArchiveTask {
  id                 Int               @id @default(autoincrement())
  photo_hash         String
  photo_path         String
  status             String            @default("NEW")
  embedding_error    String?
  thumbnail_error    String?
  database_error     String?
  faiss_error        String?
  attempt            Int               @default(0)
  retry_count        Int               @default(0)
  last_error         String?
  processing_time_ms Int?
  embedding_time_ms  Int?
  quality_score      Float?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  import_session_id  Int
  import_session     ImportSession     @relation(fields: [import_session_id], references: [id])
  steps              ArchiveTaskStep[]

  @@index([photo_hash])
  @@index([status])
  @@index([import_session_id])
}

model ArchiveTaskStep {
  id          Int         @id @default(autoincrement())
  task_id     Int
  step        String
  status      String      @default("PENDING")
  started_at  DateTime?
  finished_at DateTime?
  error       String?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  task        ArchiveTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([step])
  @@index([status])
}
